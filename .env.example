# Variable names only. scripts/seed_secrets.py reads these from the environment
# and writes them to Secrets Manager as premium/spy-api. Never commit values.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Region for scripts/seed_secrets.py (AWS_REGION is also accepted). It must match the
# CDK app region: --context region=<region>, default us-east-1 (cdk/app.py).
AWS_DEFAULT_REGION=us-east-1
